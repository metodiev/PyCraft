# Local backend environment overrides.
#
# Copy to `.env` and adjust. Every value below shows the default, so an empty
# file behaves identically to no file at all. Never commit real `.env` files —
# they are gitignored.

# --- Application -------------------------------------------------------------
# development | test | production
PYCRAFT_ENVIRONMENT=development
PYCRAFT_DEBUG=false

# Comma-separated list of allowed browser origins.
PYCRAFT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Persistence -------------------------------------------------------------
# SQLite (zero-setup, development default):
# PYCRAFT_DATABASE_URL=sqlite+aiosqlite:///./.pycraft.db
# PostgreSQL (docker-compose / production):
# PYCRAFT_DATABASE_URL=postgresql+asyncpg://pycraft:pycraft@localhost:5432/pycraft

# --- Content -----------------------------------------------------------------
# PYCRAFT_CHALLENGES_DIR=../challenges

# --- Execution ---------------------------------------------------------------
# docker (isolated, required for production) | local (UNSANDBOXED, dev only)
PYCRAFT_EXECUTION_BACKEND=docker
PYCRAFT_RUNNER_IMAGE=pycraft-runner:3.12

# Only needed when the daemon is not at the default socket.
# PYCRAFT_DOCKER_HOST=unix:///var/run/docker.sock

# Platform ceilings. A challenge may lower these but never raise them.
PYCRAFT_MAX_TIME_LIMIT_MS=10000
PYCRAFT_MAX_MEMORY_LIMIT_MB=512
PYCRAFT_MAX_OUTPUT_BYTES=65536

# Maximum simultaneous sandboxes.
PYCRAFT_EXECUTION_CONCURRENCY=4
