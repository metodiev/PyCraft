# Local backend environment overrides.
#
# Copy to `.env` and adjust. Every value below shows the default, so an empty
# file behaves identically to no file at all. Never commit real `.env` files —
# they are gitignored.

# --- Application -------------------------------------------------------------
# development | test | production
PYCRAFT_ENVIRONMENT=development
PYCRAFT_DEBUG=false

# Comma-separated list of allowed browser origins.
PYCRAFT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Persistence -------------------------------------------------------------
# SQLite (zero-setup, development default):
# PYCRAFT_DATABASE_URL=sqlite+aiosqlite:///./.pycraft.db
# PostgreSQL (docker-compose / production):
# The compose stack publishes PostgreSQL on 5433 to avoid colliding with a
# PostgreSQL already running on the machine.
# PYCRAFT_DATABASE_URL=postgresql+asyncpg://pycraft:pycraft@localhost:5433/pycraft

# --- Content -----------------------------------------------------------------
# PYCRAFT_CHALLENGES_DIR=../challenges
# PYCRAFT_TUTORIALS_DIR=../tutorials

# --- Authentication ----------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset in development, an ephemeral key is generated at startup (tokens do not
# survive a restart, and a warning is logged).
# PYCRAFT_SECRET_KEY=

PYCRAFT_JWT_ALGORITHM=HS256
PYCRAFT_ACCESS_TOKEN_TTL_MINUTES=15
PYCRAFT_REFRESH_TOKEN_TTL_DAYS=30
PYCRAFT_PASSWORD_RESET_TTL_MINUTES=60

# Set to false to run an OAuth-only deployment.
PYCRAFT_ALLOW_PASSWORD_AUTH=true
# Set to false to make the platform invite-only.
PYCRAFT_ALLOW_REGISTRATION=true

# Comma-separated emails granted the admin role on registration.
# These users can access the authoring UI and manage other accounts.
# PYCRAFT_ADMIN_EMAILS=you@example.com

# --- GitHub OAuth ------------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must be: <PYCRAFT_OAUTH_REDIRECT_BASE>/api/v1/auth/github/callback
# PYCRAFT_GITHUB_CLIENT_ID=
# PYCRAFT_GITHUB_CLIENT_SECRET=
PYCRAFT_OAUTH_REDIRECT_BASE=http://127.0.0.1:8000

# --- Email -------------------------------------------------------------------
# console: log the message (development default, no mail server needed)
# smtp:    deliver real mail
PYCRAFT_EMAIL_BACKEND=console
PYCRAFT_SMTP_HOST=
PYCRAFT_SMTP_PORT=587
PYCRAFT_SMTP_USERNAME=
PYCRAFT_SMTP_PASSWORD=
PYCRAFT_SMTP_FROM=PyCraft <noreply@pycraft.dev>
PYCRAFT_SMTP_STARTTLS=true
# Used to build links in emails.
PYCRAFT_FRONTEND_BASE_URL=http://127.0.0.1:5173

# --- Execution ---------------------------------------------------------------
# docker (isolated, required for production) | local (UNSANDBOXED, dev only)
PYCRAFT_EXECUTION_BACKEND=docker
PYCRAFT_RUNNER_IMAGE=pycraft-runner:3.12

# Only needed when the daemon is not at the default socket.
# PYCRAFT_DOCKER_HOST=unix:///var/run/docker.sock

# Platform ceilings. A challenge may lower these but never raise them.
PYCRAFT_MAX_TIME_LIMIT_MS=10000
PYCRAFT_MAX_MEMORY_LIMIT_MB=512
PYCRAFT_MAX_OUTPUT_BYTES=65536

# Maximum simultaneous sandboxes.
PYCRAFT_EXECUTION_CONCURRENCY=4

# --- Submission queue ---
# How many background workers drain the queue. Run and Submit return 202 as soon
# as the work is stored; these workers are what actually execute it. Kept at or
# below PYCRAFT_EXECUTION_CONCURRENCY so workers are not merely waiting on the
# sandbox semaphore.
PYCRAFT_WORKER_CONCURRENCY=2
# How long a worker's claim on a submission stays valid. Must comfortably exceed
# the longest sandbox run, or a slow submission is executed twice.
PYCRAFT_WORKER_LEASE_SECONDS=120
# Run the workers inside the API process. Set false when they are deployed
# separately, so the API does not duplicate the work.
PYCRAFT_RUN_WORKERS_IN_PROCESS=true
